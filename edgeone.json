{
  "headers": [
    {
      "source": "/api/files/*",
      "key": "Cache-Control",
      "value": "public, max-age=2592000, immutable"
    },
    {
      "source": "/",
      "key": "Cache-Control",
      "value": "no-store, no-cache, must-revalidate, max-age=0"
    },
    {
      "source": "/api/products",
      "key": "Cache-Control",
      "value": "no-store, no-cache, must-revalidate, max-age=0"
    }
  ]
}
